@model WebApplication1.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2 class="mb-3">Admin Dashboard</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row mb-4">
    <div class="col-md-4 mb-2">
        <div class="card text-center">
            <div class="card-body">
                <h3 class="mb-0">@Model.PendingCount</h3><span class="text-muted">Pending</span>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card text-center">
            <div class="card-body">
                <h3 class="mb-0">@Model.ApprovedCount</h3><span class="text-muted">Approved</span>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card text-center">
            <div class="card-body">
                <h3 class="mb-0">@Model.RejectedCount</h3><span class="text-muted">Rejected</span>
            </div>
        </div>
    </div>
</div>

<h4>Pending applications</h4>

@if (!Model.PendingApplications.Any())
{
    <p class="text-muted">Nothing waiting for review.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Applicant</th>
                <th>Property</th>
                <th>City</th>
                <th>Price / night</th>
                <th>Photos</th>
                <th>Submitted</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var app in Model.PendingApplications)
            {
                <tr>
                    <td>@app.Applicant?.FirstName @app.Applicant?.LastName<br /><small class="text-muted">@app.Applicant?.Email</small></td>
                    <td>@app.Property?.Title</td>
                    <td>@app.Property?.City</td>
                    <td>@app.Property?.PricePerNight.ToString("N2")</td>
                    <td>@app.Property?.Images.Count</td>
                    <td>@app.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                    <td><a class="btn btn-sm btn-primary" asp-action="Review" asp-route-id="@app.Id">Review</a></td>
                </tr>
            }
        </tbody>
    </table>
}
}
