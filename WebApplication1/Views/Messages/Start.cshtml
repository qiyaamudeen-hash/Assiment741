@model WebApplication1.ViewModels.StartMessageViewModel
@{
    ViewData["Title"] = "Message the host";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <a asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId">&larr; Back to listing</a>
        <h2 class="mt-2 mb-1">Message @Model.HostName</h2>
        <p class="text-muted">About <strong>@Model.PropertyTitle</strong></p>

        <form asp-action="Start" method="post">
            <input type="hidden" asp-for="PropertyId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Body" class="form-label"></label>
                <textarea asp-for="Body" class="form-control" rows="5" maxlength="2000"
                          placeholder="Hi! I had a question about the property..."></textarea>
                <span asp-validation-for="Body" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Send message</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}