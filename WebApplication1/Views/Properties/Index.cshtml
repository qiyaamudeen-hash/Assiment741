@model WebApplication1.ViewModels.PropertyListViewModel
@{
    ViewData["Title"] = "Explore stays";
}

<h2 class="mb-3">Explore stays</h2>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <select name="city" class="form-select" onchange="this.form.submit()">
            <option value="">All cities</option>
            @foreach (var c in Model.Cities)
            {
                <option value="@c" selected="@string.Equals(c, Model.City, StringComparison.OrdinalIgnoreCase)">@c</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <select name="type" class="form-select" onchange="this.form.submit()">
            <option value="">All property types</option>
            @foreach (var t in Enum.GetValues<PropertyType>())
            {
                <option value="@((int)t)" selected="@(Model.Type == t)">@t</option>
            }
        </select>
    </div>
    <div class="col-auto">
        @if (!string.IsNullOrEmpty(Model.City) || Model.Type.HasValue)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Clear filters</a>
        }
    </div>
</form>

@if (!Model.Properties.Any())
{
    <p class="text-muted">No stays match your filters yet.</p>
}
else
{
    <p class="text-muted">@Model.TotalCount stay@(Model.TotalCount == 1 ? "" : "s") found</p>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
        @foreach (var p in Model.Properties)
        {
            <div class="col">
                <a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none text-dark">
                    <div class="card h-100 shadow-sm">
                        @if (p.ImageUrl != null)
                        {
                            <img src="@p.ImageUrl" class="card-img-top" alt="@p.Title" style="height:200px;object-fit:cover;" />
                        }
                        <div class="card-body">
                            <h6 class="card-title mb-1">@p.Title</h6>
                            <p class="text-muted small mb-2">@p.City &middot; @p.PropertyType</p>
                            <p class="mb-0"><strong>@p.PricePerNight.ToString("N2")</strong> <span class="text-muted">/ night</span></p>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>

    <nav class="d-flex justify-content-between align-items-center mt-4">
        <div>
            @if (Model.Page > 1)
            {
                <a class="btn btn-outline-secondary btn-sm" asp-action="Index"
                   asp-route-city="@Model.City" asp-route-type="@Model.Type" asp-route-page="@(Model.Page - 1)">&larr; Previous</a>
            }
        </div>
        <span class="text-muted">Page @Model.Page of @Model.TotalPages</span>
        <div>
            @if (Model.Page < Model.TotalPages)
            {
                <a class="btn btn-outline-secondary btn-sm" asp-action="Index"
                   asp-route-city="@Model.City" asp-route-type="@Model.Type" asp-route-page="@(Model.Page + 1)">Next &rarr;</a>
            }
        </div>
    </nav>
}