@model WebApplication1.ViewModels.EditPropertyViewModel
@{
    ViewData["Title"] = "Edit Listing";
}

<a asp-action="Index">&larr; Back to dashboard</a>
<h2 class="mt-2 mb-3">Edit listing</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-6">
        <h5>Details</h5>
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="PropertyType" class="form-label"></label>
                    <select asp-for="PropertyType" asp-items="Html.GetEnumSelectList<PropertyType>()" class="form-select"></select>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="PricePerNight" class="form-label"></label>
                    <input asp-for="PricePerNight" class="form-control" />
                    <span asp-validation-for="PricePerNight" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="CleaningFee" class="form-label"></label>
                    <input asp-for="CleaningFee" class="form-control" />
                    <span asp-validation-for="CleaningFee" class="text-danger"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </form>
    </div>

    <div class="col-md-6">
        <h5>Photos (@Model.Images.Count of 10)</h5>
        <div class="d-flex flex-wrap gap-3 mb-3">
            @foreach (var img in Model.Images)
            {
                <div class="text-center">
                    <img src="@img.ImageUrl" alt="" class="img-thumbnail" style="width:150px;height:110px;object-fit:cover;" />
                    <form asp-action="DeletePhoto" asp-route-id="@Model.Id" asp-route-imageId="@img.Id" method="post"
                          onsubmit="return confirm('Delete this photo?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger mt-1">Delete</button>
                    </form>
                </div>
            }
        </div>

        <form asp-action="AddPhotos" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            <label class="form-label">Add photos</label>
            <input type="file" name="newPhotos" multiple accept=".jpg,.jpeg,.png,.webp" class="form-control mb-2" required />
            <div class="form-text mb-2">JPG, PNG or WEBP, max 5 MB each.</div>
            <button type="submit" class="btn btn-outline-primary">Upload</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}