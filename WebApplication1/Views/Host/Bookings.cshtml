@model List<WebApplication1.Models.Booking>
@{
    ViewData["Title"] = "Booking Requests";

    var today = DateOnly.FromDateTime(DateTime.Today);
    var pending = Model.Where(b => b.Status == BookingStatus.Pending).OrderBy(b => b.CheckInDate).ToList();
    var upcoming = Model.Where(b => b.Status == BookingStatus.Approved && b.CheckOutDate >= today).OrderBy(b => b.CheckInDate).ToList();
    var history = Model.Where(b => !pending.Contains(b) && !upcoming.Contains(b)).OrderByDescending(b => b.CheckInDate).ToList();

    string Badge(BookingStatus s) => s switch
    {
        BookingStatus.Approved => "bg-success",
        BookingStatus.Rejected => "bg-danger",
        BookingStatus.Cancelled => "bg-secondary",
        BookingStatus.Completed => "bg-info text-dark",
        _ => "bg-warning text-dark"
    };
}

<a asp-action="Index">&larr; Back to dashboard</a>
<h2 class="mt-2 mb-3">Booking requests</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<h4>Waiting for your response (@pending.Count)</h4>
@if (!pending.Any())
{
    <p class="text-muted">No pending requests.</p>
}
@foreach (var b in pending)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h5 class="mb-1">@b.Property?.Title</h5>
                    <p class="mb-1">Guest: <strong>@b.Guest?.FirstName @b.Guest?.LastName</strong></p>
                    <p class="mb-1 text-muted">
                        @b.CheckInDate.ToString("dd MMM yyyy") &rarr; @b.CheckOutDate.ToString("dd MMM yyyy")
                        &middot; @b.Nights night@(b.Nights == 1 ? "" : "s")
                        &middot; @b.NumberOfGuests traveller@(b.NumberOfGuests == 1 ? "" : "s")
                    </p>
                    <p class="mb-0">
                        Total <strong>@b.TotalPrice.ToString("N2")</strong>
                        <small class="text-muted">(requested @b.CreatedAt.ToLocalTime().ToString("dd MMM HH:mm"))</small>
                    </p>
                </div>
                <div class="col-md-3">
                    <form asp-action="ApproveBooking" asp-route-id="@b.Id" method="post">
                        <input name="notes" class="form-control form-control-sm mb-1" maxlength="500" placeholder="Optional message to guest" />
                        <button type="submit" class="btn btn-sm btn-success w-100">Approve</button>
                    </form>
                </div>
                <div class="col-md-3">
                    <form asp-action="RejectBooking" asp-route-id="@b.Id" method="post">
                        <input name="notes" class="form-control form-control-sm mb-1" maxlength="500" placeholder="Reason (required)" required />
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">Decline</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<h4 class="mt-4">Upcoming stays (@upcoming.Count)</h4>
@if (!upcoming.Any())
{
    <p class="text-muted">No approved stays coming up.</p>
}
@foreach (var b in upcoming)
{
    var process = b.Property?.CheckInProcess;
    var complete = CheckInStatus.IsComplete(b, process);

    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between">
                <div>
                    <h5 class="mb-1">@b.Property?.Title</h5>
                    <p class="mb-1">Guest: <strong>@b.Guest?.FirstName @b.Guest?.LastName</strong> &middot; @b.NumberOfGuests traveller@(b.NumberOfGuests == 1 ? "" : "s")</p>
                    <p class="mb-2 text-muted">
                        @b.CheckInDate.ToString("dd MMM") &rarr; @b.CheckOutDate.ToString("dd MMM yyyy") &middot; Total @b.TotalPrice.ToString("N2")
                    </p>
                </div>
                <div>
                    @if (complete)
                    {
                        <span class="badge bg-success">Check-in complete</span>
                    }
                    else
                    {

                        <span class="badge bg-warning text-dark">Check-in in progress</span>
                    }
                </div>
            </div>

            <h6>Guest check-in</h6>
            <p class="small mb-2">House rules: @(b.RulesAcceptedAt != null ? "accepted " + b.RulesAcceptedAt.Value.ToLocalTime().ToString("dd MMM HH:mm") : "not accepted yet")</p>

            @foreach (var type in CheckInStatus.RequiredList(process))
            {
                var doc = CheckInStatus.Latest(b, type);

                <div class="border rounded p-2 mb-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <span>@CheckInStatus.Name(type)</span>
                        @if (doc == null)
                        {
                            <span class="badge bg-secondary">Not uploaded</span>
                        }
                        else if (doc.Status == DocumentStatus.Pending)
                        {

                            <span class="badge bg-warning text-dark">Needs your review</span>
                        }
                        else if (doc.Status == DocumentStatus.Verified)
                        {

                            <span class="badge bg-success">Verified</span>
                        }
                        else
                        {

                            <span class="badge bg-danger">Rejected, waiting for a new upload</span>
                        }
                    </div>

                    @if (doc != null)
                    {
                        <div class="small mt-1">
                            <a asp-controller="GuestDocuments" asp-action="Open" asp-route-id="@doc.Id" target="_blank">View document</a>
                            <span class="text-muted">(@doc.OriginalFileName)</span>
                        </div>

                        @if (doc.Status == DocumentStatus.Pending)
                        {
                            <div class="row g-2 mt-1">
                                <div class="col-auto">
                                    <form asp-action="VerifyDocument" asp-route-id="@doc.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-success">Verify</button>
                                    </form>
                                </div>
                                <div class="col">
                                    <form asp-action="RejectDocument" asp-route-id="@doc.Id" method="post" class="d-flex gap-1">
                                        <input name="notes" class="form-control form-control-sm" maxlength="500" placeholder="Reason (required)" required />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                    </form>
                                </div>
                            </div>
                        }
                        else if (doc.Status == DocumentStatus.Rejected && !string.IsNullOrEmpty(doc.ReviewNote))
                        {
                            <div class="small text-muted mt-1">Your feedback: @doc.ReviewNote</div>
                        }
                    }
                </div>
            }
        </div>
    </div>
}

<h4 class="mt-4">History</h4>
@if (!history.Any())
{
    <p class="text-muted">Nothing here yet.</p>
}
else
{
    <table class="table table-sm align-middle">
        <thead>
            <tr><th>Property</th><th>Guest</th><th>Dates</th><th>Status</th><th>Note</th></tr>
        </thead>
        <tbody>
            @foreach (var b in history)
            {
                <tr>
                    <td>@b.Property?.Title</td>
                    <td>@b.Guest?.FirstName @b.Guest?.LastName</td>
                    <td>@b.CheckInDate.ToString("dd MMM") &rarr; @b.CheckOutDate.ToString("dd MMM yyyy")</td>
                    <td><span class="badge @Badge(b.Status)">@b.Status</span></td>
                    <td>@b.HostNotes</td>
                </tr>
            }
        </tbody>
    </table>
}